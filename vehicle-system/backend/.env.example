PORT=5000
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d
DB_FILE=./database.json

# Email (optional - for notification emails). Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Razorpay checkout (leave blank to keep online payments disabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OCR service
OCR_MODE=stub
# OCR_MODE=python   -> calls ocr/plate_reader.py via child_process (requires opencv-python, easyocr/tesseract installed)
DOC_OCR_MODE=disabled
# DOC_OCR_MODE=python -> enable EasyOCR document text/expiry extraction
PYTHON_BIN=python

# Optional HTTP model endpoint; accepts { features: {...} } and returns { probability: 0-100, model?: string }
PREDICTION_SERVICE_URL=
